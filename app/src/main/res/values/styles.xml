<resources>
    <style name="Theme.Tellyo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#168BFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#050B18</item>
        <item name="android:statusBarColor">#050B18</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Tellyo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050B18</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/tellyo_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">220</item>
        <item name="postSplashScreenTheme">@style/Theme.Tellyo</item>
    </style>
</resources>
